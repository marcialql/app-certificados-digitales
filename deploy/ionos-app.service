[Unit]
Description=ionos-app (firma-pdf PWA)
After=network.target

[Service]
Type=simple
User=ionos-app
Group=ionos-app
WorkingDirectory=/opt/ionos-app
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/npm run server
Restart=on-failure
RestartSec=5

# Endurecimiento
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ionos-app

[Install]
WantedBy=multi-user.target

# Caddy con el módulo DNS de IONOS: el certificado se obtiene por desafío DNS,
# así no hace falta el puerto 80 ni el 443 (los usa Caddy de vales de riego).
FROM caddy:2-builder AS build
RUN xcaddy build --with github.com/caddy-dns/ionos

FROM caddy:2
COPY --from=build /usr/bin/caddy /usr/bin/caddy
